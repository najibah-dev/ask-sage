# Copy this file to .env and fill in your own keys for local/personal use.
# Never commit the real .env.
#
# Running this without a .env at all is also supported: the app falls back to
# a "bring your own key" screen where each visitor pastes their own keys for
# their session only (nothing is stored). That's what a public deployment of
# this repo should do. See the Deploying section in README.md.

# Groq API key (required): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Places API key (required): needs Places API + Geocoding API
# enabled, with billing set up on the Google Cloud project (billing must be
# enabled for the APIs to work at all, but Google's free monthly credit
# comfortably covers personal use)
GOOGLE_PLACES_API_KEY=

# Nutrition lookups (both optional, but at least one is recommended)
USDA_API_KEY=
API_NINJAS_KEY=

# Filter Agent restaurant data depth: false = name/rating/price only (fast),
# true = also fetch Google Place Details reviews per restaurant (slower, richer)
ENRICH_WITH_REVIEWS=false
